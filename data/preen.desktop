[Desktop Entry]
Type=Application
Name=Preen
Comment=System setup and optimization for Linux
Exec=preen
Icon=preen
Terminal=false
# Keep legacy desktop IDs usable without showing a duplicate launcher.
NoDisplay=true
Categories=System;Settings;Utility;
Keywords=optimize;apps;flatpak;apt;cleanup;services;preen;
StartupNotify=true
StartupWMClass=preen
